APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
SHUTDOWN_TIMEOUT=15s
TRUSTED_PROXY_CIDRS=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=opensnow
MYSQL_USER=opensnow
MYSQL_PASSWORD=opensnow-dev
MYSQL_TLS_MODE=false
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=5m
MYSQL_PING_TIMEOUT=2s

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PING_TIMEOUT=2s
REDIS_TLS_ENABLED=false
REDIS_TLS_SERVER_NAME=
REDIS_TLS_INSECURE_SKIP_VERIFY=false

SESSION_TTL=12h
SESSION_COOKIE_SECURE=
SESSION_CLEANUP_INTERVAL=15m
SESSION_CLEANUP_BATCH=500
SESSION_REVOKED_RETENTION=24h

AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IP_WINDOW=1m
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_ACCOUNT_WINDOW=15m
AUTH_MAX_CONCURRENT_PASSWORD_CHECKS=4

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_RETRY_DELAY=5s

# The first administrator is created in the WebUI unless headless bootstrap is enabled.
BOOTSTRAP_ON_START=false
BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_TENANT_NAME="Default tenant"
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_NAME="Administrator"
# Public first-install default; password change is mandatory after login.
BOOTSTRAP_ADMIN_PASSWORD=admin
# Applies only to a newly created custom bootstrap account; existing accounts are unchanged.
BOOTSTRAP_REQUIRE_PASSWORD_CHANGE=false

# Native persistent storage, retained by restart and ordinary uninstall.
# Container stacks override this with their shared named volume.
ATTACHMENT_ROOT=.opensnow/attachments

# Optional SMTP. In-app notifications work without SMTP or an encryption key.
# Supply a stable, private base64 32-byte key outside MySQL (environment OR file).
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_ENCRYPTION_KEY_FILE=
# Explicit local Mailpit use only. STARTTLS/TLS remain the default for real SMTP.
SMTP_ALLOW_INSECURE=false
