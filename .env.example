APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=opensnow
MYSQL_USER=opensnow
MYSQL_PASSWORD=change-me
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=5m
MYSQL_PING_TIMEOUT=2s

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PING_TIMEOUT=2s

SESSION_TTL=12h
SESSION_COOKIE_SECURE=
SESSION_COOKIE_NAME=opensnow_session
CSRF_COOKIE_NAME=opensnow_csrf

AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IP_WINDOW=1m
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_ACCOUNT_WINDOW=15m

BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_TENANT_NAME=Default tenant
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
