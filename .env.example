APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_BODY_LIMIT_BYTES=1048576
HEALTH_TIMEOUT=2s

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=openservicenow
MYSQL_USER=openservicenow
MYSQL_PASSWORD=openservicenow_dev
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=5m
MYSQL_CONN_MAX_IDLE_TIME=2m
MYSQL_CONNECT_TIMEOUT=5s
MYSQL_READ_TIMEOUT=5s
MYSQL_WRITE_TIMEOUT=5s

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

MIGRATIONS_DIR=migrations
