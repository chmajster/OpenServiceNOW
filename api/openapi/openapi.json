    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "Tenant administration"
    },
    {
      "name": "User administration"
    },
    {
      "name": "RBAC administration"
    },
    {
      "name": "Audit"
    }
  ],
