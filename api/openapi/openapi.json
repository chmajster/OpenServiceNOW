{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenServiceNOW API",
    "version": "0.1.0",
    "description": "Phase 1 foundation API. The backend is authoritative for authentication, tenant scope and RBAC.\nEvery API response includes a server-generated X-Request-ID header; client-supplied request IDs are not trusted."
  },
